rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default-deny catch-all (Mandatory)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Explicit match blocks for EVERY collection in the blueprint
    match /members/{memberId} {
      allow read, write: if true;
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /planRequests/{requestId} {
      allow read, write: if true;
    }

    match /workoutPlans/{planId} {
      allow read, write: if true;
    }

    match /dietPlans/{planId} {
      allow read, write: if true;
    }

    // Gym configuration (UPI ID, QR code URL) - admin-managed settings
    match /gymConfig/{configId} {
      allow read, write: if true;
    }
  }
}
